# Copy to .env (repo root) and uncomment what you want to change.
# Every setting in backend/carsradar/config.py can be set here as CARSRADAR_<NAME>.
# CLI flags (--source, --host, --port) override this file.

# Video input: an rtsp:// or srt:// URL, or a path to a recorded clip.
# CARSRADAR_SOURCE=rtsp://127.0.0.1:8554/live/cam
# Replay a clip forever (true) or stop at its end (false).
# CARSRADAR_LOOP_FILE=true

# Web server. Use 0.0.0.0 to open the viewer from other devices on your network.
# CARSRADAR_HOST=127.0.0.1
# CARSRADAR_PORT=8000

# Frames sent to the browser are downscaled to this width; detection uses full resolution.
# CARSRADAR_DISPLAY_WIDTH=1600
# CARSRADAR_JPEG_QUALITY=80

# Detector weights (auto-downloaded into data/models/), input size and confidence threshold.
# CARSRADAR_MODEL=yolo26s.pt
# CARSRADAR_IMGSZ=1280
# CARSRADAR_CONF=0.25

# Road region as fractions of the frame [x1, y1, x2, y2]. Unset = whole frame.
# CARSRADAR_ROI=[0, 0.35, 1, 0.8]
